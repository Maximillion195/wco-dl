# WCO-DL Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Node environment (development or production)
NODE_ENV=production

# Port for the NestJS server (default: 3000)
SERVER_PORT=3000

# Port for Byparr service (default: 8191)
# Note: This is only for external access. Internal communication uses 8191.
BYPARR_PORT=8191

# ============================================================================
# DOWNLOAD SETTINGS
# ============================================================================

# Base directory for downloaded files
# In Docker: this is a volume mount point
# Outside Docker: use absolute path
OUTPUT_BASE=/data/downloads

# User ID for file permissions (production only)
PUID=1000

# Group ID for file permissions (production only)
PGID=1000

# ============================================================================
# SONARR INTEGRATION (Optional)
# ============================================================================

# Sonarr URL for automatic library imports after download
# Leave empty to disable Sonarr integration
SONARR_URL=

# Sonarr API key (get from Sonarr: Settings > General > API Key)
SONARR_API_KEY=

# ============================================================================
# CORS SETTINGS
# ============================================================================

# CORS origin (default: http://localhost:3000)
# Set to your domain if accessing from elsewhere
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# BYPARR SETTINGS (Cloudflare Bypass)
# ============================================================================

# Proxy configuration for Byparr (optional)
# Format: protocol://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Browser locale and timezone for Byparr
# Helps avoid detection by matching your region
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=UTC

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Python binary path (default: python)
PYTHON_BIN=python

# Byparr max timeout in milliseconds (default: 60000)
BYPARR_MAX_TIMEOUT_MS=60000

# Download idle timeout in milliseconds (default: 210000)
# If no output for this long, the download is killed
DOWNLOAD_IDLE_TIMEOUT_MS=210000

# ============================================================================
# WEBHOOKS
# ============================================================================

# Comma-separated webhook URLs to register at startup (optional)
WEBHOOK_URLS=

# Webhooks to loopback, link-local (169.254.x.x) and private LAN addresses are
# blocked. Set to true to allow them, e.g. for a Home Assistant webhook.
WEBHOOK_ALLOW_INTERNAL=false

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Minimal setup (no Sonarr, no proxy):
# NODE_ENV=production
# SERVER_PORT=3000
# OUTPUT_BASE=/data/downloads

# With Sonarr integration:
# NODE_ENV=production
# SERVER_PORT=3000
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=your-api-key-here
# OUTPUT_BASE=/data/downloads

# With proxy:
# NODE_ENV=production
# SERVER_PORT=3000
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass
# OUTPUT_BASE=/data/downloads
